# shellcheck shell=bash
use flake

# Route each rustc call through the kache of the host. CI enters the devshell
# without direnv, so it builds without kache. KACHE_DISABLED=1 runs one command
# without it.
export RUSTC_WRAPPER=kache

rk self-depend check || true

# Warn about a newer exobrain CLI, or newer hook revisions than the project
# pins. It reads the latest exobrain-tech release at most once in 30 days.
exobrain hooks status || true

# Warn once a day about working-tree copies in the Nix store, and about a
# build folder that holds more than 10 GB of its own data.
exobrain store-guard --daily || true
