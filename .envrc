# shellcheck shell=bash
use flake
rk self-depend check || true

# Warn about a newer exobrain CLI, or newer hook revisions than the project
# pins. It reads the latest exobrain-tech release at most once in 30 days.
exobrain hooks status || true

# Warn once a day about working-tree copies in the Nix store.
exobrain store-guard --daily || true
