{
  "markdown": {
    "lineWidth": 100,
    "textWrap": "never"
  },
  "includes": [
    "**/*.md",
    "**/*.markdown"
  ],
  // release-plz writes CHANGELOG.md, and rk renders SECURITY.md and the
  // agent skills whole, so they follow their generator. Source: the
  // dev-environment rule of nix-secrets
  // (home/apps/claude-session/rules/dev-environment.md).
  "excludes": [
    ".git",
    "node_modules",
    "CHANGELOG.md",
    "SECURITY.md",
    ".claude/skills",
    ".agents/skills"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.0.wasm"
  ]
}
