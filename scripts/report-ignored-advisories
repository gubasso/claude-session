#!/usr/bin/env bash
# Print every advisory that deny.toml ignores, with its reason, so an ignore
# stays visible on each run instead of going silent. cargo-deny prints nothing
# for an ignored advisory. Under GitHub Actions each line is a warning
# annotation. It always exits 0: the ignore is a decision, and this is its
# reminder, not a gate.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"
cd -- "$project_root"

i=0
while taplo get -f deny.toml "advisories.ignore[$i]" -o json >/dev/null 2>&1; do
  if id="$(taplo get -f deny.toml "advisories.ignore[$i].id" 2>/dev/null)"; then
    reason="$(taplo get -f deny.toml "advisories.ignore[$i].reason" 2>/dev/null || echo "no reason given")"
  else
    id="$(taplo get -f deny.toml "advisories.ignore[$i]")"
    reason="no reason given"
  fi
  if [ "${GITHUB_ACTIONS:-}" = true ]; then
    echo "::warning file=deny.toml,title=cargo-deny ignores $id::$reason"
  else
    echo "cargo-deny ignores $id: $reason"
  fi
  i=$((i + 1))
done
