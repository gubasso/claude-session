#!/usr/bin/env bash
set -euo pipefail

# Decorative emphasis is forbidden by AGENTS.md. A source-aware scan avoids
# treating examples, identifiers, link destinations, or Markdown punctuation as
# prose emphasis.

fence_open_re='^[[:space:]]{0,3}(`{3,}|~{3,})'
allow_re='^[[:space:]]*<!--[[:space:]]*allow-emphasis:[[:space:]]*([^[:space:]<][^<]*)-->[[:space:]]*$'
empty_allow_re='^[[:space:]]*<!--[[:space:]]*allow-emphasis:[[:space:]]*-->[[:space:]]*$'
found=0

for path in "$@"; do
  [[ -f "$path" ]] || continue
  case "$path" in
    *.md | *.markdown) ;;
    *) continue ;;
  esac

  in_fence=0
  fence_char=''
  fence_len=0
  allow_next=0
  line_no=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    ((line_no += 1))

    if ((in_fence)); then
      close_re="^[[:space:]]{0,3}${fence_char}{${fence_len},}[[:space:]]*$"
      if [[ $line =~ $close_re ]]; then
        in_fence=0
      fi
      continue
    fi

    if [[ $line =~ $fence_open_re ]]; then
      opener=${BASH_REMATCH[1]}
      fence_char=${opener:0:1}
      fence_len=${#opener}
      in_fence=1
      allow_next=0
      continue
    fi

    if [[ $line =~ $empty_allow_re ]]; then
      printf '%s:%d: empty allow-emphasis reason\n' "$path" "$line_no"
      found=1
      allow_next=0
      continue
    fi

    if [[ $line =~ $allow_re ]]; then
      allow_next=1
      continue
    fi

    if ((allow_next)); then
      # The formatter inserts a blank line after a standalone HTML comment, so
      # the exemption has to survive the gap it creates or it can never be used.
      if [[ -z ${line//[[:space:]]/} ]]; then
        continue
      fi
      allow_next=0
      continue
    fi

    # Emphasis requires one of these two delimiters, so lines without either
    # skip the stripping below. This keeps the whole-tree gate run cheap.
    if [[ $line != *'*'* && $line != *_* ]]; then
      continue
    fi

    # Equal-length backtick runs delimit inline code. Link destinations are
    # syntax rather than prose, escaped delimiters are literal, and horizontal
    # rules or list markers are not emphasis.
    # Single quotes keep sed backreferences literal; no shell expansion is intended.
    # shellcheck disable=SC2016
    clean=$(sed -E 's/(`+)[^`]*\1//g; s/\]\([^)]*\)/]/g' <<<"$line")
    clean=${clean//\\\*/}
    clean=${clean//\\_/}

    if [[ $clean =~ ^[[:space:]]*([*_-][[:space:]]*){3,}$ ]]; then
      continue
    fi
    if [[ $clean =~ ^([[:space:]]*)[*+-][[:space:]]+(.*)$ ]]; then
      clean=${BASH_REMATCH[1]}${BASH_REMATCH[2]}
    fi

    span=''
    if [[ $clean =~ \*\*[^*[:space:]][^*]*\*\* ]]; then
      span=${BASH_REMATCH[0]}
    elif [[ $clean =~ __[^_[:space:]][^_]*__ ]]; then
      span=${BASH_REMATCH[0]}
    elif [[ $clean =~ (^|[^*])\*[^*[:space:]][^*]*\*([^*]|$) ]]; then
      span=${BASH_REMATCH[0]}
    elif [[ $clean =~ (^|[^[:alnum:]_])_[^_[:space:]][^_]*_([^[:alnum:]_]|$) ]]; then
      span=${BASH_REMATCH[0]}
    fi

    if [[ -n $span ]]; then
      printf '%s:%d: %s\n' "$path" "$line_no" "$span"
      found=1
    fi
  done <"$path"
done

exit "$found"
