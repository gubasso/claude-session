#!/usr/bin/env bash
set -euo pipefail

# ADR-0076 and ADR-0078 make filename identity, shape, status syntax, and the
# whole-file word cap deterministic rather than review-only conventions.

expected_headings=$'## Context and Problem Statement\n## Considered Options\n## Decision Outcome\n## Consequences\n## Status'
status_re='^(Ideation|Proposed|Accepted|Implemented|Deprecated|Superseded|Rejected)$'
successor_re='\]\((\.\.?/)[^)]*ADR-[0-9]{4}[^)]*\)'
found=0
previous=0
declare -A seen=()

mapfile -t files < <(find docs/decisions -maxdepth 1 -type f -name 'ADR-*.md' | sort)

for path in "${files[@]}"; do
  base=${path##*/}
  id=${base#ADR-}
  id=${id%%-*}
  numeric=$((10#$id))

  if [[ -n ${seen[$id]:-} ]]; then
    printf '%s: duplicate ADR id %s\n' "$path" "$id"
    found=1
  fi
  seen[$id]=1

  if ((numeric != previous + 1)); then
    printf '%s: ADR ids are not contiguous after %04d\n' "$path" "$previous"
    found=1
  fi
  previous=$numeric

  title=$(sed -n '1p' "$path")
  if [[ $title != "# ADR-$id:"* ]]; then
    printf '%s: filename and title id disagree\n' "$path"
    found=1
  fi

  headings=$(grep '^## ' "$path" || true)
  if [[ $headings != "$expected_headings" ]]; then
    printf '%s: headings differ from the five-section template\n' "$path"
    found=1
  fi

  status=$(awk '/^## Status$/ { active=1; next } active && NF { print; exit }' "$path")
  if [[ ! $status =~ $status_re ]]; then
    printf '%s: invalid first nonblank status value: %s\n' "$path" "$status"
    found=1
  fi

  words=$(wc -w <"$path")
  if ((words > 350)); then
    printf '%s: %d words exceeds 350\n' "$path" "$words"
    found=1
  fi

  status_tail=$(sed -n '/^## Status$/,$p' "$path")
  if [[ $status == Superseded && ! $status_tail =~ $successor_re ]]; then
    printf '%s: Superseded status lacks a relative successor link\n' "$path"
    found=1
  fi
  # Enactment evidence is the artifact that carries out the decision, so a link
  # to another record does not count: an "Amended by" or "Supersedes" line alone
  # would otherwise satisfy this gate and leave it inert.
  if [[ $status == Implemented ]] &&
    ! grep -oE '\]\(\.\.?/[^)]*\)' <<<"$status_tail" | grep -qvE 'ADR-[0-9]{4}'; then
    printf '%s: Implemented status lacks a link to the artifact that enacts it\n' "$path"
    found=1
  fi
done

template=docs/decisions/template.md
template_headings=$(grep '^## ' "$template" || true)
if [[ $template_headings != "$expected_headings" ]]; then
  printf '%s: headings differ from the five-section template\n' "$template"
  found=1
fi
for value in Ideation Proposed Accepted Implemented Deprecated Superseded Rejected; do
  if ! grep -q "$value" "$template"; then
    printf '%s: advertised status set lacks %s\n' "$template" "$value"
    found=1
  fi
done

exit "$found"
