#!/usr/bin/env bash
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

mapfile -t named < <(awk '
  /^## Acceptance$/ { active=1; next }
  /^## Rabbit holes$/ { active=0 }
  active && / -> / { sub(/^.* -> /, ""); print }
' docs/plan/slices/*/README.md)

if ((${#named[@]} == 0)); then
  printf '%s\n' 'no acceptance test IDs were found'
  exit 1
fi

duplicates=$(printf '%s\n' "${named[@]}" | sort | uniq -d)
if [[ -n $duplicates ]]; then
  printf 'duplicate acceptance test ID: %s\n' "$duplicates"
  exit 1
fi

listing=$(mktemp)
trap 'rm -f -- "$listing"' EXIT

# Run the listing as a plain command, not inside a process substitution:
# bash never inspects a substituted subshell's status and `pipefail` does not
# reach into one, so a failed or truncated listing would arrive here as a set
# of missing IDs and blame the slice document for a build problem.
if ! cargo nextest list --all-features >"$listing"; then
  printf '%s\n' 'cargo nextest list failed; the acceptance IDs are unchecked'
  exit 1
fi

mapfile -t actual < <(awk '
  $1 ~ /::bin\// { print $2; next }
  { prefix=$1; sub(/^claude-session::/, "", prefix); print prefix "::" $2 }
' "$listing")

if ((${#actual[@]} == 0)); then
  printf '%s\n' 'cargo nextest list named no test; the acceptance IDs are unchecked'
  exit 1
fi

unresolved=()
for test_id in "${named[@]}"; do
  if ! printf '%s\n' "${actual[@]}" | grep -Fxq -- "$test_id"; then
    unresolved+=("$test_id")
  fi
done

# Report the whole set against both totals. One unresolved ID out of many
# reads as a stale or partial build, a large share as slice drift; the first
# mismatch alone cannot tell those apart.
if ((${#unresolved[@]} > 0)); then
  printf '%d named, %d listed, %d unresolved\n' \
    "${#named[@]}" "${#actual[@]}" "${#unresolved[@]}"
  printf 'unresolved acceptance test ID: %s\n' "${unresolved[@]}"
  exit 1
fi

fixture=(alpha alpha)
[[ $(printf '%s\n' "${fixture[@]}" | sort | uniq -d) == alpha ]] || {
  printf '%s\n' 'check-acceptance-tests: duplicate negative fixture failed'
  exit 1
}
if printf '%s\n' "${actual[@]}" | grep -Fxq -- '__definitely_missing_test__'; then
  printf '%s\n' 'check-acceptance-tests: unresolved negative fixture failed'
  exit 1
fi
